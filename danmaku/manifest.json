{
  "manifest_version": 3,
  "name": "鱼鱼谷 · 斗法托管",
  "version": "0.2.0",
  "description": "修仙试炼弹幕斗法的图像识别托管：前台看状态，后台由本地 Python 程序抓屏识别、模拟鼠标走位和放符卡。",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://52dmeme.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "斗法托管",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://52dmeme.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
